{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "procucev-enterprise-frontend",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "NODE_BACKEND_URL": "https://procucev-enterprise-backend-test.anshul-goel.workers.dev",
    "NEXT_PUBLIC_BACKEND_URL": "https://procucev-enterprise-backend-test.anshul-goel.workers.dev"
  },
  "env": {
    "dev": {
      "name": "procucev-enterprise-frontend",
      "account_id": "97a5dd65ad21c0f5dcd8547de147c806",
      "vars": {
        "NODE_BACKEND_URL": "https://procucev-enterprise-backend-test.anshul-goel.workers.dev",
        "NEXT_PUBLIC_BACKEND_URL": "https://procucev-enterprise-backend-test.anshul-goel.workers.dev"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "test": {
      "name": "procucev-enterprise-frontend-test",
      "vars": {
        "NODE_BACKEND_URL": "https://procucev-enterprise-backend-test.anshul-goel.workers.dev",
        "NEXT_PUBLIC_BACKEND_URL": "https://procucev-enterprise-backend-test.anshul-goel.workers.dev"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "prod": {
      "name": "procucev-enterprise-frontend",
      "vars": {
        "NODE_BACKEND_URL": "https://procucev-enterprise-backend.srinivas-mukku.workers.dev",
        "NEXT_PUBLIC_BACKEND_URL": "https://procucev-enterprise-backend.srinivas-mukku.workers.dev"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "production": {
      "name": "procucev-enterprise-frontend",
      "vars": {
        "NODE_BACKEND_URL": "https://procucev-enterprise-backend.srinivas-mukku.workers.dev",
        "NEXT_PUBLIC_BACKEND_URL": "https://procucev-enterprise-backend.srinivas-mukku.workers.dev"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
