# ==============================================================================
# PROCUCEV ENTERPRISE FRONTEND (NEXT.JS) - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

NODE_ENV=development
PORT=3000

# Backend Reverse Proxy Target
NODE_BACKEND_URL=http://localhost:4000
# Backend-only query settings; configure these in the backend deployment environment.
SLOW_QUERY_THRESHOLD_MS=200
# Backend-only D1 query logging controls; listed for workspace env parity.
D1_QUERY_SUCCESS_LOG_SAMPLE_RATE=0.01
# 0 logs every D1 query; the backend applies this setting.
D1_QUERY_HIGH_READ_ROWS_THRESHOLD=1000

# Client-Side Exposed Environment Variables
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_GRAPHQL_URL=/api/graphql
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_AES_CIPHER=AES-GCM
NEXT_PUBLIC_VENDOR_DIRECTORY_ACCESS_KEY=Procucev@Vendors2026


# Action Center Approver Configuration
# Approval password secrets are backend-only; never add them as NEXT_PUBLIC variables.
NEXT_PUBLIC_DEFAULT_APPROVER=Srinu Sir
NEXT_PUBLIC_SRINU_APPROVER_EMAIL=srinivas.mukku@procucev.com
NEXT_PUBLIC_SUDHEER_APPROVER_EMAIL=sudheer.kangala@procucev.com
