# ==============================================================================
# PROCUCEV ENTERPRISE PROCUREMENT PLATFORM (QUA AI 2.0)
# PostgreSQL & Infrastructure Environment Variables Configuration
# ==============================================================================

# Primary PostgreSQL Database Connection URL
# Supports Vercel Postgres, Neon, Supabase, Azure Database for PostgreSQL, AWS RDS, or Local Postgres.
#
# Examples:
# - Neon / Vercel Postgres:
#   DATABASE_URL="postgres://default:secret@ep-cool-pond-123456.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require"
#
# - Supabase:
#   DATABASE_URL="postgresql://postgres:your-super-secret-password@db.xyzcompany.supabase.co:5432/postgres"
#
# - Azure Database for PostgreSQL Flexible Server:
#   DATABASE_URL="postgresql://procucevadmin:SecretPassword123!@psql-procucev-centralindia.postgres.database.azure.com:5432/procucev_prod?sslmode=require"
#
# - Local PostgreSQL / Docker:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/procucev_enterprise"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/procucev_enterprise"

# Optional: Vercel Postgres Alternative Parameter Aliases
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/procucev_enterprise"
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/procucev_enterprise"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/procucev_enterprise"

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Azure OpenAI / LLM Model Configuration
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o"

# Application Security & Audit Keys
AUTH_SECRET="procucev-enterprise-secure-jwt-key-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
