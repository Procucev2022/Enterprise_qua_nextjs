# ==============================================================================
# PROCUCEV ENTERPRISE (QUA AI 2.0) - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================
# Copy this file to .env or configure in your deployment orchestrator / CI/CD pipeline.
# Do NOT include real production secrets, passwords, or private keys in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
CI=false

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4000
AUTO_START_SERVER=true

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SHARED PROCUCEV MYSQL IDENTITY SCHEMA)
# ------------------------------------------------------------------------------
# Identity database (shared Procucev MySQL schema) - authenticates real logins
# against the `user` table. Domain records are served from the in-memory store.
MYSQL_HOST=your-server.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_DATABASE=development_gmtbfs
MYSQL_USER=db_user_placeholder
MYSQL_PASSWORD=db_password_placeholder
MYSQL_POOL_MAX=5
MYSQL_CONNECT_TIMEOUT_MS=15000
MYSQL_SSL=true

# Query Cache & Profiling Configuration
QUERY_CACHE_TTL_MS=60000
QUERY_CACHE_MAX_ENTRIES=500
SLOW_QUERY_THRESHOLD_MS=200

# ------------------------------------------------------------------------------
# 3b. DOMAIN DATABASE (Neon PostgreSQL — vendors + RFQs only)
# ------------------------------------------------------------------------------
# Leave DATABASE_URL unset to run fully in-memory (seed data only). After
# setting it, run `npm run db:migrate --prefix backend` once to create the
# schema and seed it.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3c. CLOUDFLARE R2 (RFQ attachment storage, S3-compatible)
# ------------------------------------------------------------------------------
# Leave unset and uploads fail closed rather than silently falling back to
# local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; derived from R2_ACCOUNT_ID by default.
R2_ENDPOINT=
# Object key prefix within the bucket.
RFQ_ATTACHMENT_DIR=uploads/rfq-attachments
RFQ_ATTACHMENT_MAX_BYTES=10485760
RFQ_ATTACHMENT_MAX_PER_RFQ=10

# ------------------------------------------------------------------------------
# 4. STRUCTURED LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. AES ENCRYPTION & CRYPTOGRAPHY CONFIGURATION
# ------------------------------------------------------------------------------
# Master 256-bit encryption key (64 hex characters or 32-byte string)
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_SECRET_KEY=enterprise-qua-ai-master-secret-key-placeholder-32b
AES_CIPHER_ALGORITHM=aes-256-gcm

# ------------------------------------------------------------------------------
# 6. FRONTEND & API GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
NODE_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_GRAPHQL_URL=/api/graphql
NEXT_PUBLIC_APP_ENV=development


# ------------------------------------------------------------------------------
# 7. GEMINI AI — RFQ DOCUMENT LINE-ITEM EXTRACTION
# ------------------------------------------------------------------------------
# Powers AI extraction in the buyer ingestion wizard (Step 2). The key is read
# server-side only and is never sent to the browser. Without it the wizard still
# works: extraction reports NOT_CONFIGURED and the buyer adds line items manually.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override these only to change model or endpoint.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.7-flash,gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_MS=20000
# Ceiling for the whole model chain, not one attempt. Extraction is answered
# inside a browser request, so the walk must finish while a client is listening.
GEMINI_TOTAL_BUDGET_MS=24000
# Remaining budget below which a further model is not attempted.
GEMINI_MIN_ATTEMPT_MS=3000
GEMINI_MAX_DOCUMENT_BYTES=10485760
GEMINI_MAX_DOCUMENT_TEXT_CHARS=120000

# Preload the demo RFQs, AI feed and audit trail. Off by default so the RFQ
# portfolio summary reports only real work; the test suite seeds them regardless.
SEED_DEMO_RFQS=false
