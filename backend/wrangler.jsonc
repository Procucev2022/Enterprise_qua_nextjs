{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "procucev-enterprise-backend",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "main": "src/worker.mjs",
  "alias": {
    "iconv-lite": "./src/workerShims/iconvLiteShim.js",
    "pdfkit": "./node_modules/pdfkit/js/pdfkit.js"
  },
  "vars": {
    "NODE_ENV": "production",
