# ==============================================================================
# PROCUCEV ENTERPRISE (QUA AI 2.0) - NODE.JS PLATFORM ENVIRONMENT VARIABLES
# ==============================================================================

# Server Port
PORT=4000

# Node Environment
NODE_ENV=development

# Database Connection String (PostgreSQL)
# Works with Neon, Supabase, Azure PostgreSQL Flexible Server, AWS RDS, or Local Postgres
# If left empty, the application runs seamlessly in High-Performance In-Memory Mode
DATABASE_URL=

# Database Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# AI Chaser Engine Simulation Settings
AI_CHASER_SIMULATION_ENABLED=true
AI_CHASER_INTERVAL_SECONDS=45

# Multi-Channel API Credentials (Optional / Simulated in Offline Mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_CLOUD_API_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
