# ==============================================================================
# PROCUCEV ENTERPRISE BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

PORT=4000
NODE_ENV=development
AUTO_START_SERVER=true

# ------------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL) — the only datastore
# ------------------------------------------------------------------------------
# Logins are verified against the `user` table here, the buyer profile and the
# procurement category taxonomy live here, and so does every domain record.
#
# There is no second database. The MYSQL_* / IDENTITY_DB_* settings this file used
# to carry are gone, along with the mysql2 driver.
#
# Leave DATABASE_URL unset and the app still starts, but every data-backed
# request — including sign-in — fails closed with a descriptive error. It does
# not fall back to in-memory seed data.
#
# First-time setup:
#   npm run db:migrate                       # creates the schema; seeds nothing
#   npm run create-buyer -- --email a@b.com --phone 9876543210 --password 'Secret@123'
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
# Idle clients are released this quickly because a managed/serverless provider
# bills for compute for as long as a connection is held open.
DATABASE_IDLE_TIMEOUT_MS=10000

# Query Cache & Profiling Configuration
QUERY_CACHE_TTL_MS=60000
QUERY_CACHE_MAX_ENTRIES=500
SLOW_QUERY_THRESHOLD_MS=200

# Structured Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_BYTES=10485760

# AES-256-GCM Encryption
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_SECRET_KEY=enterprise-qua-ai-master-secret-key-placeholder-32b
AES_CIPHER_ALGORITHM=aes-256-gcm

# Session token signing. Required in production — the process refuses to start
# without it. Outside production a random key is generated per process, so
# sessions stop verifying after a restart until this is set. There is no
# hardcoded fallback key any more.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# SMTP (Gmail) - used to email OTP codes/onboarding invites/etc; no-ops if
# either is unset. Works fine for local dev, but Render (and several other
# PaaS hosts) block outbound SMTP (25/465/587) at the network level on every
# plan, so this alone will silently fail to send in production there
# (ETIMEDOUT/CONN - the TCP connection itself never completes).
SMTP_USER=
SMTP_PASSWORD=

# Resend (https://resend.com) - HTTPS-API email delivery, used automatically
# instead of SMTP whenever RESEND_API_KEY is set. Required on Render (see
# note above) since it isn't blocked like raw SMTP. RESEND_FROM_EMAIL must be
# an address on a domain verified with Resend; falls back to SMTP_FROM/
# SMTP_USER if unset (fine for local testing against Resend's own sandbox
# domain, not for real delivery).
RESEND_API_KEY=
RESEND_FROM_EMAIL=


# ------------------------------------------------------------------------------
# GEMINI AI — RFQ DOCUMENT LINE-ITEM EXTRACTION
# ------------------------------------------------------------------------------
# Powers POST /api/rfqs/extract, which the buyer ingestion wizard calls in Step 2.
# Read server-side only; never exposed to the browser. Without a key the endpoint
# returns 422 NOT_CONFIGURED and the wizard falls back to manual line-item entry.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.7-flash,gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_MS=20000
# Ceiling for the whole model chain, not one attempt. Extraction is answered
# inside a browser request, so the walk must finish while a client is listening.
GEMINI_TOTAL_BUDGET_MS=24000
# Remaining budget below which a further model is not attempted.
GEMINI_MIN_ATTEMPT_MS=3000
GEMINI_MAX_DOCUMENT_BYTES=10485760
GEMINI_MAX_DOCUMENT_TEXT_CHARS=120000

# SEED_DEMO_RFQS is gone. There is no seed data left to preload — records come
# from real use, and an empty database reports itself as empty.

# ------------------------------------------------------------------------------
# CLOUDFLARE R2 (RFQ attachment storage, S3-compatible)
# Leave unset and uploads fail closed with a clear error rather than silently
# falling back to local disk.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; derived from R2_ACCOUNT_ID by default.
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# RFQ ATTACHMENTS
# ------------------------------------------------------------------------------
# Object key prefix within the R2 bucket (was the local storage directory
# before the R2 migration).
RFQ_ATTACHMENT_DIR=uploads/rfq-attachments
RFQ_ATTACHMENT_MAX_BYTES=10485760
RFQ_ATTACHMENT_MAX_PER_RFQ=10

# ------------------------------------------------------------------------------
# EMAIL-TO-RFQ INGESTION
# ------------------------------------------------------------------------------
# Applies to an emailed requisition (.eml) uploaded through the ingestion wizard
# and parsed by POST /api/rfqs/extract-email. All three have working defaults, so
# none of them has to be set.
#
# Ceiling on the decoded message, checked before parsing. Larger than the
# attachment limit because a message carries its attachments inline as base64.
EMAIL_INGESTION_MAX_BYTES=15728640
# How many attachment parts are inspected on one message.
EMAIL_INGESTION_MAX_ATTACHMENTS=10
# Cap on how much of a decoded text attachment (CSV, plain text) is appended to
# the extractor input, so one oversized file cannot crowd out the message body.
EMAIL_INGESTION_MAX_TEXT_CHARS=40000

# ------------------------------------------------------------------------------
# AUTONOMOUS EMAIL INGESTION GATEWAY (IMAP)
# ------------------------------------------------------------------------------
# Watches a mailbox and raises an RFQ from each inbound requisition. Off by
# default; the backend logs why it did not start when any of these is missing.
#
# Ingested RFQs are held in the 'Parsing' status for a category manager to review
# and are NOT circulated to vendors automatically.
EMAIL_GATEWAY_ENABLED=false
# Gmail: imap.gmail.com / 993. Microsoft 365: outlook.office365.com / 993.
EMAIL_GATEWAY_HOST=
EMAIL_GATEWAY_PORT=993
EMAIL_GATEWAY_SECURE=true
EMAIL_GATEWAY_USER=
# The Procucev intake address buyers send their requisitions TO, e.g.
# navinchaudhary.dev@gmail.com. Shown on the buyer's gateway panel. Defaults to
# EMAIL_GATEWAY_USER when unset, but set it explicitly whenever mail is addressed
# to an alias or shared mailbox that differs from the IMAP login above.
EMAIL_GATEWAY_ADDRESS=navinchaudhary.dev@gmail.com
# Gmail requires an App Password here — a normal account password is refused.
# This is a credential: keep it out of version control.
EMAIL_GATEWAY_PASSWORD=
EMAIL_GATEWAY_MAILBOX=INBOX
# Floor is 30000ms regardless of what is set. Each poll opens a connection and may
# call Gemini per message, so a shorter interval burns quota and risks throttling.
EMAIL_GATEWAY_POLL_MS=120000
# Messages handled per pass; the remainder waits for the next tick.
EMAIL_GATEWAY_MAX_PER_POLL=10
#
# WHO MAY RAISE A REQUISITION BY EMAIL
# Baseline rule, always applied: the sender must already be registered as a buyer
# account. Without one the RFQ would have no owner and appear on no dashboard, and
# anyone who learned this address could otherwise inject RFQs.
#
# Optional, to narrow it further. Comma-separated, case-insensitive.
#   ALLOWED_SENDERS, when set, is the whole rule — only these addresses, and each
#   still needs a buyer account.
#   ALLOWED_DOMAINS narrows the baseline rule to these domains.
EMAIL_GATEWAY_ALLOWED_SENDERS=
EMAIL_GATEWAY_ALLOWED_DOMAINS=
