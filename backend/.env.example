# ==============================================================================
# PROCUCEV ENTERPRISE BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

PORT=4000
NODE_ENV=development
AUTO_START_SERVER=true

# ------------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL) — the only datastore
# ------------------------------------------------------------------------------
# Logins are verified against the `user` table here, the buyer profile and the
# procurement category taxonomy live here, and so does every domain record.
#
# There is no second database. The MYSQL_* / IDENTITY_DB_* settings this file used
# to carry are gone, along with the mysql2 driver.
#
# Leave DATABASE_URL unset and the app still starts, but every data-backed
# request — including sign-in — fails closed with a descriptive error. It does
# not fall back to in-memory seed data.
#
# First-time setup:
#   npm run db:migrate                       # creates the schema; seeds nothing
#   npm run create-buyer -- --email a@b.com --phone 9876543210 --password 'Secret@123'
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
# Idle clients are released this quickly because a managed/serverless provider
# bills for compute for as long as a connection is held open.
DATABASE_IDLE_TIMEOUT_MS=10000

# Query Cache & Profiling Configuration
QUERY_CACHE_TTL_MS=60000
QUERY_CACHE_MAX_ENTRIES=500
SLOW_QUERY_THRESHOLD_MS=200

# Structured Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_BYTES=10485760

# AES-256-GCM Encryption
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_SECRET_KEY=enterprise-qua-ai-master-secret-key-placeholder-32b
AES_CIPHER_ALGORITHM=aes-256-gcm

# Session token signing. Required in production — the process refuses to start
# without it. Outside production a random key is generated per process, so
# sessions stop verifying after a restart until this is set. There is no
# hardcoded fallback key any more.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# SMTP (Gmail) - used to email OTP codes; sendOtpEmail no-ops if either is unset
SMTP_USER=
SMTP_PASSWORD=


# ------------------------------------------------------------------------------
# GEMINI AI — RFQ DOCUMENT LINE-ITEM EXTRACTION
# ------------------------------------------------------------------------------
# Powers POST /api/rfqs/extract, which the buyer ingestion wizard calls in Step 2.
# Read server-side only; never exposed to the browser. Without a key the endpoint
# returns 422 NOT_CONFIGURED and the wizard falls back to manual line-item entry.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.7-flash,gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_MS=20000
# Ceiling for the whole model chain, not one attempt. Extraction is answered
# inside a browser request, so the walk must finish while a client is listening.
GEMINI_TOTAL_BUDGET_MS=24000
# Remaining budget below which a further model is not attempted.
GEMINI_MIN_ATTEMPT_MS=3000
GEMINI_MAX_DOCUMENT_BYTES=10485760
GEMINI_MAX_DOCUMENT_TEXT_CHARS=120000

# SEED_DEMO_RFQS is gone. There is no seed data left to preload — records come
# from real use, and an empty database reports itself as empty.

# ------------------------------------------------------------------------------
# CLOUDFLARE R2 (RFQ attachment storage, S3-compatible)
# Leave unset and uploads fail closed with a clear error rather than silently
# falling back to local disk.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; derived from R2_ACCOUNT_ID by default.
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# RFQ ATTACHMENTS
# ------------------------------------------------------------------------------
# Object key prefix within the R2 bucket (was the local storage directory
# before the R2 migration).
RFQ_ATTACHMENT_DIR=uploads/rfq-attachments
RFQ_ATTACHMENT_MAX_BYTES=10485760
RFQ_ATTACHMENT_MAX_PER_RFQ=10
