# ==============================================================================
# PROCUCEV ENTERPRISE BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

PORT=4000
NODE_ENV=development
AUTO_START_SERVER=true

# ------------------------------------------------------------------------------
# IDENTITY DATABASE (shared Procucev MySQL schema)
# Logins are verified against the `user` table in this schema. Leave unset to
# disable database-backed authentication entirely (all logins then fail closed).
# ------------------------------------------------------------------------------
MYSQL_HOST=your-server.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_DATABASE=development_gmtbfs
MYSQL_USER=db_user_placeholder
MYSQL_PASSWORD=db_password_placeholder
MYSQL_POOL_MAX=5
MYSQL_CONNECT_TIMEOUT_MS=15000
# Set to "false" only for a local MySQL without TLS
MYSQL_SSL=true

# Query Cache & Profiling Configuration
QUERY_CACHE_TTL_MS=60000
QUERY_CACHE_MAX_ENTRIES=500
SLOW_QUERY_THRESHOLD_MS=200

# Structured Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_BYTES=10485760

# AES-256-GCM Encryption
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_SECRET_KEY=enterprise-qua-ai-master-secret-key-placeholder-32b
AES_CIPHER_ALGORITHM=aes-256-gcm

# Session token signing - required in production; dev falls back to an insecure default
AUTH_SECRET=

# SMTP (Gmail) - used to email OTP codes; sendOtpEmail no-ops if either is unset
SMTP_USER=
SMTP_PASSWORD=


# ------------------------------------------------------------------------------
# GEMINI AI — RFQ DOCUMENT LINE-ITEM EXTRACTION
# ------------------------------------------------------------------------------
# Powers POST /api/rfqs/extract, which the buyer ingestion wizard calls in Step 2.
# Read server-side only; never exposed to the browser. Without a key the endpoint
# returns 422 NOT_CONFIGURED and the wizard falls back to manual line-item entry.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest
GEMINI_REQUEST_TIMEOUT_MS=20000
# Ceiling for the whole model chain, not one attempt. Extraction is answered
# inside a browser request, so the walk must finish while a client is listening.
GEMINI_TOTAL_BUDGET_MS=45000
# Remaining budget below which a further model is not attempted.
GEMINI_MIN_ATTEMPT_MS=3000
GEMINI_MAX_DOCUMENT_BYTES=10485760
GEMINI_MAX_DOCUMENT_TEXT_CHARS=120000
