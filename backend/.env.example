# ==============================================================================
# PROCUCEV ENTERPRISE BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

PORT=4000
NODE_ENV=development
AUTO_START_SERVER=true
AUTO_RUN_SEED=true

# Database Connection URIs
DATABASE_URL=postgresql://procucev_user:password_placeholder@localhost:5432/procucev_enterprise?sslmode=prefer
POSTGRES_URL=postgresql://procucev_user:password_placeholder@localhost:5432/procucev_enterprise
POSTGRES_PRISMA_URL=postgresql://procucev_user:password_placeholder@localhost:5432/procucev_enterprise
POSTGRES_URL_NON_POOLING=postgresql://procucev_user:password_placeholder@localhost:5432/procucev_enterprise

# Database Connection Pool Tuning
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# Query Cache & Profiling Configuration
QUERY_CACHE_TTL_MS=60000
QUERY_CACHE_MAX_ENTRIES=500
SLOW_QUERY_THRESHOLD_MS=200

# Structured Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_BYTES=10485760
