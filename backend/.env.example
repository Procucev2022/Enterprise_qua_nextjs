# ==============================================================================
# PROCUCEV ENTERPRISE BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

PORT=4000
NODE_ENV=development
AUTO_START_SERVER=true

# ------------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL) — the only datastore
# ------------------------------------------------------------------------------
# Logins are verified against the `user` table here, the buyer profile and the
# procurement category taxonomy live here, and so does every domain record.
#
# There is no second database. The MYSQL_* / IDENTITY_DB_* settings this file used
# to carry are gone, along with the mysql2 driver.
#
# Leave DATABASE_URL unset and the app still starts, but every data-backed
# request — including sign-in — fails closed with a descriptive error. It does
# not fall back to in-memory seed data.
#
# First-time setup:
#   npm run db:migrate                       # creates the schema; seeds nothing
#   npm run create-buyer -- --email a@b.com --phone 9876543210 --password 'Secret@123'
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
# Idle clients are released this quickly because a managed/serverless provider
# bills for compute for as long as a connection is held open.
DATABASE_IDLE_TIMEOUT_MS=10000

# Query Cache & Profiling Configuration
QUERY_CACHE_TTL_MS=60000
QUERY_CACHE_MAX_ENTRIES=500
SLOW_QUERY_THRESHOLD_MS=200

# Structured Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_BYTES=10485760

# AES-256-GCM Encryption
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_SECRET_KEY=enterprise-qua-ai-master-secret-key-placeholder-32b
AES_CIPHER_ALGORITHM=aes-256-gcm

# Google Gemini AI Document Extraction
# Supports a single API key or a comma-separated list of multiple keys for round-robin rotation across free tier limits
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_MAX_KEY_ATTEMPTS_PER_MODEL=3
GEMINI_PER_MODEL_TIMEOUT_MS=0
GEMINI_TOTAL_BUDGET_MS=900000

# Session token signing. Required in production — the process refuses to start
# without it. Outside production a random key is generated per process, so
# sessions stop verifying after a restart until this is set. There is no
# hardcoded fallback key any more.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# SMTP (Gmail) - used to email OTP codes/onboarding invites/etc; no-ops if
# either is unset. Works fine for local dev, but Render (and several other
# PaaS hosts) block outbound SMTP (25/465/587) at the network level on every
# plan, so this alone will silently fail to send in production there
# (ETIMEDOUT/CONN - the TCP connection itself never completes).
SMTP_USER=
SMTP_PASSWORD=

# Gmail API (buyer-side outbound mail) — takes priority over SMTP/Resend
# whenever all three are set, since raw SMTP cannot send at all on Cloudflare
# Workers (its TLS layer doesn't implement `rejectUnauthorized`). Mint via
# `node scripts/get-gmail-refresh-token.js /path/to/client_secret_*.json`
# (Desktop-app OAuth2 client from Google Cloud Console, gmail.send scope).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Resend (https://resend.com) - HTTPS-API email delivery, used automatically
# instead of SMTP whenever RESEND_API_KEY is set. Required on Render (see
# note above) since it isn't blocked like raw SMTP. RESEND_FROM_EMAIL must be
# an address on a domain verified with Resend; falls back to SMTP_FROM/
# SMTP_USER if unset (fine for local testing against Resend's own sandbox
# domain, not for real delivery).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OUTBOUND DELIVERY CHAIN (mailerService.routeDelivery)
# Every send tries, in order: the channel's Gmail mailbox -> the buyer Gmail
# mailbox -> GMAIL_POOL_* mailboxes -> HTTP providers (Resend, SendGrid, Brevo,
# MailChannels — whichever have a key) -> raw SMTP (off Cloudflare Workers only).
# A provider that is rate-limited or whose credential is rejected is skipped
# until it can work again. Each Gmail mailbox has its own daily sending limit
# (~500 for gmail.com, ~2,000 for Workspace), so add mailboxes or an HTTP
# provider to scale. Publish the Google OAuth app "In production": refresh
# tokens of an app left in "Testing" expire after 7 days (invalid_grant).
#
# Dedicated OTP mailbox: sign-in codes go here first, so gateway/notification
# volume can never block logins. OTP mail may also borrow every other mailbox.
OTP_GMAIL_REFRESH_TOKEN=
OTP_GMAIL_SENDER_EMAIL=
# Extra Gmail mailboxes shared by all channels (comma-separated, same order).
GMAIL_POOL_REFRESH_TOKENS=
GMAIL_POOL_SENDER_EMAILS=
# Optional HTTP providers. *_FROM_EMAIL must be on a domain verified there.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# MailChannels no longer accepts unauthenticated sends; only used with a key.
MAILCHANNELS_API_KEY=
MAILCHANNELS_FROM_EMAIL=
# Domains the platform sends from; mail from them never gets an "unregistered
# sender" notice (stops notice loops with auto-forwarding company mailboxes).
PLATFORM_EMAIL_DOMAINS=procucev.com


# ------------------------------------------------------------------------------
# GEMINI AI — RFQ DOCUMENT LINE-ITEM EXTRACTION
# ------------------------------------------------------------------------------
# Powers POST /api/rfqs/extract, which the buyer ingestion wizard calls in Step 2.
# Read server-side only; never exposed to the browser. Without a key the endpoint
# returns 422 NOT_CONFIGURED and the wizard falls back to manual line-item entry.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated list of Gemini models attempted in order. Extraction automatically
# tries each model in sequence upon error or 503 overload and retains the working model.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Gemini extraction timeout and document-size policy is defined in
# src/config/constants.js and is not environment-configurable.
# Maximum number of API keys attempted on an individual model before failing over
# to the next fallback model.
GEMINI_MAX_KEY_ATTEMPTS_PER_MODEL=3
GEMINI_PER_MODEL_TIMEOUT_MS=0

# SEED_DEMO_RFQS is gone. There is no seed data left to preload — records come
# from real use, and an empty database reports itself as empty.

# ------------------------------------------------------------------------------
# CLOUDFLARE R2 (RFQ attachment storage, S3-compatible)
# Leave unset and uploads fail closed with a clear error rather than silently
# falling back to local disk.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional override; derived from R2_ACCOUNT_ID by default.
R2_ENDPOINT=

# ------------------------------------------------------------------------------
# RFQ ATTACHMENTS
# ------------------------------------------------------------------------------
# Object key prefix within the R2 bucket (was the local storage directory
# before the R2 migration).
RFQ_ATTACHMENT_DIR=uploads/rfq-attachments
RFQ_ATTACHMENT_MAX_BYTES=10485760
RFQ_ATTACHMENT_MAX_PER_RFQ=10

# ------------------------------------------------------------------------------
# EMAIL-TO-RFQ INGESTION
# ------------------------------------------------------------------------------
# Applies to an emailed requisition (.eml) uploaded through the ingestion wizard
# and parsed by POST /api/rfqs/extract-email. All three have working defaults, so
# none of them has to be set.
#
# Ceiling on the decoded message, checked before parsing. Larger than the
# attachment limit because a message carries its attachments inline as base64.
EMAIL_INGESTION_MAX_BYTES=15728640
# How many attachment parts are inspected on one message.
EMAIL_INGESTION_MAX_ATTACHMENTS=10
# Cap on how much of a decoded text attachment (CSV, plain text) is appended to
# the extractor input, so one oversized file cannot crowd out the message body.
EMAIL_INGESTION_MAX_TEXT_CHARS=40000

# ------------------------------------------------------------------------------
# AUTONOMOUS EMAIL INGESTION GATEWAY (IMAP)
# ------------------------------------------------------------------------------
# Watches a mailbox and raises an RFQ from each inbound requisition. Off by
# default; the backend logs why it did not start when any of these is missing.
#
# This flag also gates the Cloudflare Workers scheduled() cron poll path
# (pollViaGmailApi / pollBothInboxesOnce), not only the Node setInterval
# watchers (startBuyerPolling). When false, the cron poll returns
# { skipped: true, reason: DISABLED } and never lists/fetches/modifies the
# mailbox. Each deployment (dev vs prod) owns its OWN value in its OWN secret
# store, so set it per worker.
#
# Ingested RFQs are held in the 'Parsing' status for a category manager to review
# and are NOT circulated to vendors automatically.
EMAIL_GATEWAY_ENABLED=false
# Gmail: imap.gmail.com / 993. Microsoft 365: outlook.office365.com / 993.
EMAIL_GATEWAY_HOST=
EMAIL_GATEWAY_PORT=993
EMAIL_GATEWAY_SECURE=true
EMAIL_GATEWAY_USER=
# The Procucev intake address buyers send their requisitions TO, e.g.
# navinchaudhary.dev@gmail.com. Shown on the buyer's gateway panel. Defaults to
# EMAIL_GATEWAY_USER when unset, but set it explicitly whenever mail is addressed
# to an alias or shared mailbox that differs from the IMAP login above.
EMAIL_GATEWAY_ADDRESS=navinchaudhary.dev@gmail.com
# Gmail requires an App Password here — a normal account password is refused.
# This is a credential: keep it out of version control.
EMAIL_GATEWAY_PASSWORD=
EMAIL_GATEWAY_MAILBOX=INBOX
# Floor is 30000ms regardless of what is set. Each poll opens a connection and may
# call Gemini per message, so a shorter interval burns quota and risks throttling.
EMAIL_GATEWAY_POLL_MS=120000
# Messages handled per pass; the remainder waits for the next tick.
EMAIL_GATEWAY_MAX_PER_POLL=10
#
# WHO MAY RAISE A REQUISITION BY EMAIL
# Baseline rule, always applied: the sender must already be registered as a buyer
# account. Without one the RFQ would have no owner and appear on no dashboard, and
# anyone who learned this address could otherwise inject RFQs.
#
# Optional, to narrow it further. Comma-separated, case-insensitive.
#   ALLOWED_SENDERS, when set, is the whole rule — only these addresses, and each
#   still needs a buyer account.
#   ALLOWED_DOMAINS narrows the baseline rule to these domains.
EMAIL_GATEWAY_ALLOWED_SENDERS=
EMAIL_GATEWAY_ALLOWED_DOMAINS=

# ------------------------------------------------------------------------------
# VENDOR NOTIFICATIONS & QUOTATION GATEWAY (SMTP & IMAP)
# ------------------------------------------------------------------------------
# Dedicated email channel for vendor interactions: outgoing vendor RFQ invites
# are sent from this email, and incoming vendor quote replies are parsed and
# added directly as quotations on the RFQ in the portal.
# (Keeps buyer RFQ creation strictly separated on EMAIL_GATEWAY_* / rfqprocucev@gmail.com).
VENDOR_SMTP_USER=
VENDOR_SMTP_PASSWORD=
VENDOR_SMTP_HOST=smtp.gmail.com
VENDOR_SMTP_PORT=465
VENDOR_SMTP_SECURE=true
VENDOR_SMTP_FROM="Procucev Enterprise" <srinu20252026@gmail.com>

# Raw SMTP (above) cannot run on Cloudflare Workers at all — its TLS layer
# doesn't implement `rejectUnauthorized`, so VENDOR_SMTP_* never actually
# sends there (confirmed live). The dedicated vendor mailbox instead goes
# through the Gmail API, same OAuth2 client as GMAIL_CLIENT_ID/SECRET below
# but its own refresh token — mint one via
# `node scripts/get-gmail-refresh-token.js /path/to/client_secret_*.json`,
# signing in as the vendor mailbox account. Takes priority over VENDOR_SMTP_*
# in deliverVendor() when set.
VENDOR_GMAIL_REFRESH_TOKEN=
VENDOR_GMAIL_SENDER_EMAIL=srinu20252026@gmail.com

# Like EMAIL_GATEWAY_ENABLED, this also gates the Cloudflare Workers cron poll
# path for the vendor inbox (pollVendorViaGmailApi delegates to pollViaGmailApi).
# When false, the vendor cron poll returns { skipped: true, reason: DISABLED }.
# Defaults to EMAIL_GATEWAY_ENABLED when unset. Each deployment owns its OWN value.
VENDOR_EMAIL_GATEWAY_ENABLED=true
VENDOR_EMAIL_GATEWAY_HOST=imap.gmail.com
VENDOR_EMAIL_GATEWAY_PORT=993
VENDOR_EMAIL_GATEWAY_SECURE=true
VENDOR_EMAIL_GATEWAY_USER=
VENDOR_EMAIL_GATEWAY_PASSWORD=
VENDOR_EMAIL_GATEWAY_ADDRESS=vendor-rfq@procucev.com
VENDOR_EMAIL_GATEWAY_MAILBOX=INBOX
VENDOR_EMAIL_GATEWAY_POLL_MS=120000
VENDOR_EMAIL_GATEWAY_MAX_PER_POLL=10

# ------------------------------------------------------------------------------
# SMS GATEWAY CONFIGURATION (DLT & Transactional SMS via sendmsg.in)
# ------------------------------------------------------------------------------
SMS_GATEWAY_URL=https://sms.sendmsg.in/datasend
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
SMS_GATEWAY_SENDER=PROCUC
SMS_GATEWAY_SMSGID=TEST
# RFQ alerts use the campaign API account; buyer/OTP SMS retain SMS_GATEWAY_USER.
SMS_GATEWAY_RFQ_USER=
# Optional RFQ-only API password; configure as a Cloudflare secret in Workers.
SMS_GATEWAY_RFQ_PASS=
# RFQ invitations use the registered DLT template shown in constants.js.
\r
SMS_GATEWAY_ACTION_CENTER_SMSGID=1777179138668879299

# ------------------------------------------------------------------------------
# WHATSAPP GATEWAY CONFIGURATION
#
# PRIMARY: sendmsg.in (ICS / Procucev production WABA)
#   Set WHATSAPP_USERNAME + WHATSAPP_PASSWORD + WHATSAPP_FROM_NUMBER.
#   The service sends an approved template message via /mediasend.
#   WHATSAPP_TEMPLATE_RFQ_NOTIFICATION must match the approved template name
#   on your sendmsg.in account.
#
# SECONDARY: Meta Cloud API (graph.facebook.com)
#   Set WHATSAPP_PHONE_NUMBER_ID + WHATSAPP_ACCESS_TOKEN if you want Meta as
#   a fallback when sendmsg.in is unavailable.  Leave blank to skip.
#
# FALLBACK: a wa.me deep-link is always returned — the caller can surface it
#   even when neither gateway is configured.
# ------------------------------------------------------------------------------

# sendmsg.in credentials (primary gateway)
WHATSAPP_USERNAME=your_sendmsg_username
WHATSAPP_PASSWORD=your_sendmsg_password
WHATSAPP_FROM_NUMBER=91XXXXXXXXXX
WHATSAPP_BASE_URL=https://media.sendmsg.in
WHATSAPP_TEMPLATE_BASE_URL=https://wsapi.sendmsg.in
WHATSAPP_TEMPLATE_RFQ_NOTIFICATION=rfq_notification_for_sellers_for_rfq_feb_5
WHATSAPP_TEMPLATE_BFS_BID_NOTIFICATION=bfs_bid_notification_for_sellers_updated

# Meta Cloud API credentials (secondary / optional)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ==============================================================================
# WHATSAPP AGENT-BOT BRIDGE (/api/bot)
# ==============================================================================
# The WhatsApp agent bot (ai-proc-agent-bot) uses this backend's existing APIs;
# /api/bot holds only what they don't offer it (session by phone/id, accounts by
# phone, WhatsApp flags, email, vendor plans). Closed (503) until BOT_API_KEY is
# set; the bot sends the same value in its X-Bot-Api-Key header (BOT_API_KEY in
# the bot's own environment). On Workers set it as a secret:
#   npx wrangler secret put BOT_API_KEY --env dev   (and --env prod)
BOT_API_KEY=
# true = new WhatsApp registrations stay unapproved until the bot's domain check
# (or an admin) approves them, as in QUA. false = approved immediately, as every
# other registration here is.
BOT_REGISTRATION_REQUIRES_APPROVAL=false

# Shared
WHATSAPP_SUPPORT_NUMBER=+91XXXXXXXXXX

# Public frontend URL — used by WhatsApp and SMS services to build 1-click
# vendor bid links (e.g. https://procucev.com/vendor/quotation-form?rfq=...).
PUBLIC_FRONTEND_URL=https://procucev.com

# ------------------------------------------------------------------------------
# DYNAMIC SUBSCRIPTION PRICING & GST CONFIGURATION
# ------------------------------------------------------------------------------
# Configurable GST tax percentage applied to subscription amounts
SUBSCRIPTION_GST_PERCENT=18

# Buyer Subscription Plans (Monthly Base Rate in INR)
BUYER_V1_6M_PRICE=5499
BUYER_V1_12M_PRICE=4999
BUYER_V2_6M_PRICE=7999
BUYER_V2_12M_PRICE=7499
BUYER_V3_6M_PRICE=10499
BUYER_V3_12M_PRICE=9999

# Seller / Vendor Subscription Plans (Total Package Price in INR, GST inclusive)
SELLER_V1_6M_PRICE=4125
SELLER_V1_12M_PRICE=7499
SELLER_V2_6M_PRICE=8250
SELLER_V2_12M_PRICE=14999
SELLER_V3_6M_PRICE=11000
SELLER_V3_12M_PRICE=19999

# Enterprise Vendor Directory Access Control
VENDOR_DIRECTORY_ACCESS_KEY=Procucev@Vendors2026

